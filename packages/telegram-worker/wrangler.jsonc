{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "telegram-worker",
    "main": "src/index.ts",
    "compatibility_date": "2025-10-11",
    // @sentry/cloudflare needs the AsyncLocalStorage API.
    "compatibility_flags": ["nodejs_compat"],
    "services": [
        { "binding": "TRANSIT_API", "service": "api-worker" },
        {
            "binding": "REPORT_API",
            "service": "api-worker",
            "entrypoint": "TrustedTelegramReportsEntrypoint",
        },
    ],
    "durable_objects": { "bindings": [{ "name": "CITY_DELIVERY", "class_name": "CityDelivery" }] },
    "migrations": [{ "tag": "v1-city-delivery", "new_sqlite_classes": ["CityDelivery"] }],
    "vars": {
        "NODE_ENV": "production",
        // URL identity for transit requests/cache keys; transport uses TRANSIT_API.
        "BACKEND_URL": "https://api.freifahren.org",
        "MISTRAL_MODEL": "mistral-small-latest",
        "SENTRY_DSN": "https://9d9ac700f1213d4db367b557167a0594@o4508609338867712.ingest.de.sentry.io/4511633367564368",
    },
    // Incoming webhook messages run in waitUntil without retries. Outgoing notifications
    // are persisted by CITY_DELIVERY, which schedules individual messages or digests.
    // Transit reads use TRANSIT_API; notifications cache responses locally for one hour.
    // Secrets (set via `wrangler secret put`):
    // MISTRAL_API_KEY and TELEGRAM_WEBHOOK_SECRET.
}
