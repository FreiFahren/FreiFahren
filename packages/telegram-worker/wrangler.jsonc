{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "telegram-worker",
    "main": "src/index.ts",
    "compatibility_date": "2025-10-11",
    // @sentry/cloudflare needs the AsyncLocalStorage API.
    "compatibility_flags": ["nodejs_compat"],
    "services": [
        { "binding": "TRANSIT_API", "service": "api-worker" },
        {
            "binding": "REPORT_API",
            "service": "api-worker",
            "entrypoint": "TrustedTelegramReportsEntrypoint",
        },
    ],
    "vars": {
        "NODE_ENV": "production",
        // URL identity for transit requests/cache keys; transport uses TRANSIT_API.
        "BACKEND_URL": "https://api.freifahren.org",
        "MISTRAL_MODEL": "mistral-small-latest",
        "SENTRY_DSN": "https://9d9ac700f1213d4db367b557167a0594@o4508609338867712.ingest.de.sentry.io/4511633367564368",
    },
    // Messages are processed in the background (ctx.waitUntil) with no queue/retry; failed
    // runs are dropped but captured in Sentry (see src/observability.ts) — alert on the
    // error rate there. Transit reads use TRANSIT_API; notifications cache responses locally
    // for one hour. Secrets (set via `wrangler secret put`):
    // MISTRAL_API_KEY and TELEGRAM_WEBHOOK_SECRET.
}
