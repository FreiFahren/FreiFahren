# Local `wrangler dev` secrets/vars (copy to .dev.vars — gitignored). Production secrets are set
# with `wrangler secret put`. The worker uses the local D1 binding (miniflare state under
# .wrangler/), so DATABASE_URL is not needed here.
SENTRY_DSN=
STRIPE_WEBHOOK_SECRET=
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
