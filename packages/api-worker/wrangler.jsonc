{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "api-worker",
    "main": "src/worker.ts",
    "compatibility_date": "2025-10-11",
    "compatibility_flags": ["nodejs_compat"],
    "cache": {
        "enabled": true,
    },
    "observability": {
        "traces": {
            "enabled": true,
            "destinations": ["sentry-traces"],
            // Slow D1 calls are frequent enough for 10% sampling to capture several each day.
            "head_sampling_rate": 0.1,
        },
    },
    "workers_dev": true,
    "routes": [
        {
            "pattern": "api.freifahren.org/*",
            "zone_name": "freifahren.org",
        },
    ],
    "services": [
        {
            "binding": "REPORT_GATE",
            "service": "report-gate",
            "entrypoint": "PublicReportsEntrypoint",
        },
    ],
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "api-worker-db-eu",
            "database_id": "f8e11f14-15a5-42a8-8eba-5ab513175890",
            "migrations_dir": "drizzle",
        },
        {
            "binding": "DB_LEIPZIG",
            "database_name": "api-worker-db-leipzig",
            "database_id": "e590b909-ce9e-4b32-8761-8e86f2e036d3",
            "migrations_dir": "drizzle",
        },
        {
            "binding": "DB_HAMBURG",
            "database_name": "api-worker-db-hamburg-eu",
            "database_id": "78b57951-828b-4673-a63f-4f5de233b184",
            "migrations_dir": "drizzle",
        },
    ],
    "vars": {
        "NODE_ENV": "production",
        "CORS_ORIGINS": "https://freifahren.org,https://app.freifahren.org,https://www.freifahren.org,https://berlin.freifahren.org,https://hamburg.freifahren.org,https://leipzig.freifahren.org,http://localhost:1871,http://hamburg.localhost:1871,http://leipzig.localhost:1871,capacitor://localhost",
        // Scopes frontend preview CORS to `frontend-pr-<n>.freifahren.workers.dev` (our account only).
        "PREVIEW_WORKERS_SUBDOMAIN": "freifahren",
        "SENTRY_DSN": "https://8f49e71a73d689efdcaabfd8794457b6@o4508609338867712.ingest.de.sentry.io/4511638467051600",
        // Matches the code default, but pinned rather than left to it: rates we compute from the
        // logs need the successful cases, and those only ever log at info. Raising this to trim
        // volume would keep the failures and drop the denominator, which reads as "nothing wrong"
        // instead of as a gap.
        "LOG_LEVEL": "info",
        "POSTHOG_API_KEY": "phc_rR635vqhSmp6st6GYqJG23uZVCmtESsDQT4Caijwv2N5",
        "POSTHOG_HOST": "https://eu.i.posthog.com",
    },
}
