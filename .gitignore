.DS_Store

# Each package ignores its own node_modules, which leaves a root-level one — created by tooling run
# From the repo root rather than inside a package — tracked by nothing and staged by `git add -A`.
node_modules/
packages/tile-server/source/*
!packages/tile-server/source/freifahren-style.json
packages/tile-server/dist/
settings.json
*.log
*.tsbuildinfo
.env
__pycache__
packages/*.log.*
packages/frontend/dist/
data/*
scripts/segments.geojson
scripts/stations.json
scripts/lines.json
scripts/export.geojson
scripts/Pipfile
scripts/Pipfile.lock
messages.*.json
eval_results.*.json

# Agent worktrees are local scratch, not project state.
.claude/worktrees/

# The report-spam skill and its scripts describe how we tell coordinated submission from a busy
# evening — the measurements, the thresholds, which defence the current actor has already beaten.
# That is worth more to them than the flag predicates are, and this repo is meant to be public
# again. Kept locally and shared out of band.
.claude/skills/report-spam/

# Decrypted trust-flag definitions. The committed artefact is trust-flags.enc; see
# packages/api-worker/src/trust-flags.ts.
packages/api-worker/trust-flags.json
